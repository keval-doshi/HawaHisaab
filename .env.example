# Server port (Vercel injects PORT automatically)
PORT=8080

# Gemini API key (server-side only, never exposed to client)
GEMINI_API_KEY=

# Gemini model name (defaults to latest Flash model if unset)
GEMINI_MODEL=gemini-3.5-flash
# Comma-separated models tried if the primary model is overloaded (503) or unavailable
GEMINI_FALLBACK_MODELS=gemini-2.5-flash

# Environment mode
NODE_ENV=development
